# ============================================================================
# GEONIXA LOOM APP — ENVIRONMENT CONFIGURATION
# ============================================================================

# API Base URL (defaults to Next.js internal App Router Route Handlers '/api')
NEXT_PUBLIC_API_URL=/api

# Deep-Link Cross-App URL to Geonixa LMS Portal
NEXT_PUBLIC_LMS_URL=http://localhost:3002

# MongoDB Atlas Persistent Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lsj9dut.mongodb.net/loom?appName=Cluster0

# HS256 JWT Secret (must match between Loom and LMS for cross-app session validation)
JWT_SECRET=8f7e2c91a3b5c6d4e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0
JWT_EXPIRATION=86400

# Google Drive Storage Integration (Resumable Uploads & Private Streaming)
# Either base64-encoded or stringified JSON service account key
GOOGLE_SERVICE_ACCOUNT_KEY=
# Default Google Drive storage folder ID for Loom videos
GOOGLE_DRIVE_FOLDER_ID=

# Email / Workspace Invite SMTP Settings (Nodemailer)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Razorpay SaaS Monthly Rent / Subscription Configuration
# (Can be provided later; system operates in test mode if keys are pending)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

